<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             xmlns:converters="clr-namespace:CampusEats.Converters"
             x:Class="CampusEats.Views.RecipePage"
             x:Name="RecipePageView"
             Title="Recipe Library"
             x:DataType="viewmodels:RecipePageViewModel">

    <ContentPage.Resources>
        <converters:BoolToFavoriteConverter x:Key="BoolToFavoriteConverter" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:StringNotNullToBoolConverter x:Key="StringNotNullToBoolConverter" />
    </ContentPage.Resources>

    <VerticalStackLayout>
        <SearchBar
            Text="{Binding SearchText}"
            Placeholder="Search recipes..."
            SearchCommand="{Binding SearchCommand}"
            AutomationProperties.Name="Search recipes by name or ingredients" />

        <ScrollView Orientation="Horizontal" Padding="{StaticResource DefaultMargin}">
            <HorizontalStackLayout Spacing="{StaticResource MediumSpacing}">
                <Button Text="Photo Recognition" Command="{Binding CaptureAndRecognizeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        AutomationProperties.Name="Take photo to recognize food ingredients" />
                <Button Text="Shake to Recommend" Command="{Binding ShakeToRecommendCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        AutomationProperties.Name="Shake device for random recipe recommendation" />
            </HorizontalStackLayout>
        </ScrollView>

        <Label
            Text="{Binding StatusMessage}"
            IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullToBoolConverter}}"
            Padding="{StaticResource DefaultMargin}"
            HorizontalOptions="Center"
            FontAttributes="Italic"
            TextColor="{StaticResource PrimaryColor}"
            AutomationProperties.Name="Current operation status message" />

        <ScrollView Orientation="Horizontal" Padding="{StaticResource DefaultMargin}">
            <HorizontalStackLayout Spacing="{StaticResource MediumSpacing}">
                <Button Text="All Categories" Command="{Binding FilterCommand}" CommandParameter="All"
                        AutomationProperties.Name="Show all recipe categories" />
                <Button Text="Staples" Command="{Binding FilterCommand}" CommandParameter="Staples"
                        AutomationProperties.Name="Show staple food recipes" />
                <Button Text="Desserts" Command="{Binding FilterCommand}" CommandParameter="Desserts"
                        AutomationProperties.Name="Show dessert recipes" />
                <Button Text="Vegetarian" Command="{Binding FilterCommand}" CommandParameter="Vegetarian"
                        AutomationProperties.Name="Show vegetarian recipes" />
                <Button Text="Soups" Command="{Binding FilterCommand}" CommandParameter="Soups"
                        AutomationProperties.Name="Show soup recipes" />
                <Button Text="Favorites" Command="{Binding FilterCommand}" CommandParameter="Favorites"
                        AutomationProperties.Name="Show favorite recipes" />
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="RecipeCollection"
                            ItemsSource="{Binding Recipes}"
                            SelectionMode="None"
                            AutomationProperties.Name="Recipe collection, scroll to browse all recipes">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <Grid Padding="{StaticResource DefaultMargin}" MaximumWidthRequest="{OnIdiom Phone=600, Tablet=800}">
                            <Border StrokeShape="RoundRectangle 12" Padding="{StaticResource DefaultMargin}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RecipePageView}, Path=BindingContext.SelectRecipeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{OnIdiom Phone=90, Tablet=120}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding ImageName}" Aspect="AspectFill"
                                           HeightRequest="{OnIdiom Phone=90, Tablet=120}"
                                           WidthRequest="{OnIdiom Phone=90, Tablet=120}"
                                           AutomationProperties.Name="Recipe image thumbnail" />
                                    <VerticalStackLayout Grid.Column="1" Padding="{StaticResource SmallMargin}">
                                        <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                                            <Label Text="{Binding CategoryIcon}" FontSize="{DynamicResource MediumFontSize}" />
                                            <Label Text="{Binding Name}" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                                                   AutomationProperties.Name="Recipe name" />
                                            <ImageButton Source="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteConverter}}"
                                                         WidthRequest="{OnIdiom Phone=28, Tablet=32}" HeightRequest="{OnIdiom Phone=28, Tablet=32}"
                                                         Clicked="OnFavoriteClicked"
                                                         AutomationProperties.Name="Toggle recipe favorite status" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Category}" FontSize="{DynamicResource SmallFontSize}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                               AutomationProperties.Name="Recipe category" />
                                        <Label Text="{Binding RatingStars}" FontSize="{DynamicResource SmallFontSize}"
                                               TextColor="{StaticResource PrimaryColor}"
                                               AutomationProperties.Name="Recipe rating" />
                                        <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                                            <Label Text="{Binding Calories, StringFormat='{}{0} cal'}"
                                                   FontSize="{DynamicResource ExtraSmallFontSize}"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                            <Label Text="|" FontSize="{DynamicResource ExtraSmallFontSize}"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                            <Label Text="{Binding PrepTime, StringFormat='{}{0} min'}"
                                                   FontSize="{DynamicResource ExtraSmallFontSize}"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="{StaticResource ExtraLargeMargin}" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No recipes found" FontSize="{DynamicResource MediumFontSize}" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </VerticalStackLayout>
</ContentPage>