<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             x:Class="CampusEats.Views.MainPage"
             Title="Campus Eats"
             x:DataType="viewmodels:MainPageViewModel">

	<ContentPage.Resources>
		<ResourceDictionary>
			<Color x:Key="PrimaryColor">#FF6B35</Color>
			<Color x:Key="CardBackgroundLight">#FFFFFF</Color>
			<Color x:Key="CardBackgroundDark">#1f1f1f</Color>
			<Color x:Key="TextColorLight">#000000</Color>
			<Color x:Key="TextColorDark">#FFFFFF</Color>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto, Auto, *">
		<VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource PrimaryColor}" Padding="20,30,20,15">
			<Label Text="🍜 Campus Eats" FontSize="28" FontAttributes="Bold" TextColor="White" 
				   AutomationProperties.Name="Campus Eats app title" />
			<Label Text="{Binding LocationStatus}" FontSize="14" TextColor="White" Opacity="0.9" 
				   AutomationProperties.Name="Current location status" />
		</VerticalStackLayout>

		<HorizontalStackLayout Grid.Row="1" Padding="15" Spacing="10">
			<Button Text="🎲 Shake to Recommend" Command="{Binding ShakeToRecommendCommand}" HorizontalOptions="Fill" 
					AutomationProperties.Name="Shake to recommend random restaurant" />
			<Button Text="🔄 Refresh" Command="{Binding RefreshCommand}" 
					AutomationProperties.Name="Refresh restaurant list" />
		</HorizontalStackLayout>

		<RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
			<CollectionView ItemsSource="{Binding Restaurants}" 
							SelectionMode="Single"
							SelectionChangedCommand="{Binding SelectRestaurantCommand}"
							SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}"
							AutomationProperties.Name="Restaurant list">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:Restaurant">
						<Grid Padding="12,5">
							<Frame CornerRadius="15" Padding="10" Margin="0,5" HasShadow="True">
								<Frame.BackgroundColor>
									<AppThemeBinding Light="{StaticResource CardBackgroundLight}" Dark="{StaticResource CardBackgroundDark}" />
								</Frame.BackgroundColor>
								<Grid ColumnDefinitions="80, *">
									<Image Source="{Binding ImageName}" HeightRequest="70" WidthRequest="70" Aspect="AspectFill" 
										   AutomationProperties.Name="Restaurant image" />
									<VerticalStackLayout Grid.Column="1" Padding="10,0">
										<Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold">
											<Label.TextColor>
												<AppThemeBinding Light="{StaticResource TextColorLight}" Dark="{StaticResource TextColorDark}" />
											</Label.TextColor>
										</Label>
										<Label Text="{Binding Cuisine}" FontSize="12">
											<Label.TextColor>
												<AppThemeBinding Light="#666666" Dark="#AAAAAA" />
											</Label.TextColor>
										</Label>
										<Label Text="{Binding RatingStars}" FontSize="12" TextColor="{StaticResource PrimaryColor}" 
											   AutomationProperties.Name="Rating" />
										<Label Text="{Binding Distance, StringFormat='📍 {0:F1} km'}" FontSize="11" TextColor="{StaticResource PrimaryColor}" 
											   AutomationProperties.Name="Distance" />
									</VerticalStackLayout>
								</Grid>
							</Frame>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
				<CollectionView.EmptyView>
					<VerticalStackLayout Padding="40" HorizontalOptions="Center">
						<Label Text="🍽️ No Restaurants" FontSize="20" HorizontalOptions="Center" />
						<Label Text="Pull to refresh or check location settings" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />
					</VerticalStackLayout>
				</CollectionView.EmptyView>
			</CollectionView>
		</RefreshView>
	</Grid>
</ContentPage>
