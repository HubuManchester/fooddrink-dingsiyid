<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             x:Class="CampusEats.Views.MainPage"
             x:Name="MainPageView"
             Title="Campus Eats"
             x:DataType="viewmodels:MainPageViewModel">

    <Grid RowDefinitions="Auto, Auto, *">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource PrimaryColor}" Padding="{StaticResource LargeMargin}">
            <Label Text="Campus Eats" FontSize="{DynamicResource LargeTitleFontSize}" FontAttributes="Bold" TextColor="White"
                   LineBreakMode="WordWrap" MaxLines="0"
                   AutomationProperties.Name="Campus Eats application title" />
            <Label Text="{Binding LocationStatus}" FontSize="{DynamicResource DefaultFontSize}" TextColor="White" Opacity="0.9"
                   LineBreakMode="WordWrap" MaxLines="0"
                   AutomationProperties.Name="Current location status" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal" Padding="{StaticResource MediumMargin}">
            <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                <Picker Title="Filter" ItemsSource="{Binding CuisineFilters}" SelectedItem="{Binding SelectedCuisine}"
                        WidthRequest="{OnIdiom Phone=120, Tablet=140}" MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                        AutomationProperties.Name="Filter restaurants by cuisine type" />
                <Button Text="Shake" Command="{Binding ShakeToRecommendCommand}" WidthRequest="{OnIdiom Phone=60, Tablet=80}"
                        AutomationProperties.Name="Shake device to recommend random restaurant" />
                <Button Text="Refresh" Command="{Binding RefreshCommand}" WidthRequest="{OnIdiom Phone=70, Tablet=80}"
                        AutomationProperties.Name="Refresh restaurant list" />
                <Button Text="Add" Command="{Binding AddRestaurantCommand}" WidthRequest="{OnIdiom Phone=60, Tablet=70}"
                        AutomationProperties.Name="Add new restaurant" />
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="RestaurantCollection"
                            ItemsSource="{Binding Restaurants}"
                            AutomationProperties.Name="Restaurant list, scroll to browse">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Restaurant">
                        <Grid Padding="{StaticResource DefaultMargin}">
                            <Frame CornerRadius="{StaticResource LargeCornerRadius}" Padding="{StaticResource DefaultMargin}" HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference MainPageView}, Path=BindingContext.SelectRestaurantCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Frame.BackgroundColor>
                                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                                </Frame.BackgroundColor>
                                <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto">
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill"
                                           HeightRequest="{OnIdiom Phone=60, Tablet=80}" WidthRequest="{OnIdiom Phone=60, Tablet=80}"
                                           AutomationProperties.Name="Restaurant image" />
                                    <VerticalStackLayout Grid.Column="1" Padding="{StaticResource SmallMargin}" Spacing="{StaticResource SmallSpacing}">
                                        <Label Text="{Binding Name}" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                                               LineBreakMode="WordWrap" MaxLines="2">
                                            <Label.TextColor>
                                                <AppThemeBinding Light="{StaticResource LightText}" Dark="{StaticResource DarkText}" />
                                            </Label.TextColor>
                                        </Label>
                                        <Label Text="{Binding Cuisine}" FontSize="{DynamicResource SmallFontSize}"
                                               LineBreakMode="WordWrap" MaxLines="1">
                                            <Label.TextColor>
                                                <AppThemeBinding Light="{StaticResource LightTextSecondary}" Dark="{StaticResource DarkTextSecondary}}" />
                                            </Label.TextColor>
                                        </Label>
                                        <Label Text="{Binding RatingStars}" FontSize="{DynamicResource SmallFontSize}" TextColor="{StaticResource PrimaryColor}"
                                               AutomationProperties.Name="Restaurant rating stars" />
                                        <Label Text="{Binding Distance, StringFormat='{0:F1} km'}" FontSize="{DynamicResource ExtraSmallFontSize}" TextColor="{StaticResource PrimaryColor}"
                                               AutomationProperties.Name="Distance from current location in kilometers" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="{StaticResource SmallSpacing}">
                                        <Button Text="{Binding FavoriteIcon}" FontSize="24" BackgroundColor="Transparent" 
                                                Command="{Binding Source={x:Reference MainPageView}, Path=BindingContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding .}" WidthRequest="44" HeightRequest="44"
                                                AutomationProperties.Name="Toggle restaurant favorite status" />
                                        <ImageButton Source="edit_icon.png" Command="{Binding Source={x:Reference MainPageView}, Path=BindingContext.EditRestaurantCommand}"
                                                     CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40"
                                                     AutomationProperties.Name="Edit restaurant" />
                                        <ImageButton Source="delete_icon.png" Command="{Binding Source={x:Reference MainPageView}, Path=BindingContext.DeleteRestaurantCommand}"
                                                     CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40"
                                                     AutomationProperties.Name="Delete restaurant" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="{StaticResource ExtraLargeMargin}" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No Restaurants" FontSize="{DynamicResource HeaderFontSize}" HorizontalOptions="Center"
                               LineBreakMode="WordWrap" MaxLines="0">
                            <Label.TextColor>
                                <AppThemeBinding Light="{StaticResource LightText}" Dark="{StaticResource DarkText}" />
                            </Label.TextColor>
                        </Label>
                        <Label Text="Pull down to refresh or check location settings" FontSize="{DynamicResource DefaultFontSize}"
                               HorizontalOptions="Center" LineBreakMode="WordWrap" MaxLines="0">
                            <Label.TextColor>
                                <AppThemeBinding Light="{StaticResource LightTextSecondary}" Dark="{StaticResource DarkTextSecondary}" />
                            </Label.TextColor>
                        </Label>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>