<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             xmlns:converters="clr-namespace:CampusEats.Converters"
             x:Class="CampusEats.Views.DetailPage"
             Title="{Binding PageTitle}"
             x:DataType="viewmodels:DetailPageViewModel">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Back" Command="{Binding GoBackCommand}" Order="Primary" Priority="0" 
                     AutomationProperties.Name="Navigate back to restaurants list" />
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource LargeMargin}" Spacing="{StaticResource DefaultSpacing}">
                <Border StrokeShape="RoundRectangle 16" Padding="{StaticResource DefaultMargin}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                    <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                        <Label Text="{Binding Restaurant.Name}" FontSize="{DynamicResource TitleFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" LineBreakMode="WordWrap" MaxLines="0"
                               AutomationProperties.Name="Restaurant name" />
                        <Label Text="{Binding Restaurant.Cuisine}" FontSize="{DynamicResource MediumFontSize}"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" LineBreakMode="WordWrap" MaxLines="0"
                               AutomationProperties.Name="Cuisine type" />
                        <Label Text="{Binding Restaurant.RatingStars}" FontSize="{DynamicResource MediumFontSize}"
                               TextColor="#FFD700" LineBreakMode="WordWrap" MaxLines="1"
                               AutomationProperties.Name="Restaurant rating" />
                        <Label Text="{Binding Restaurant.Distance, StringFormat='{0:F1} km from you'}"
                               FontSize="{DynamicResource DefaultFontSize}" LineBreakMode="WordWrap" MaxLines="0"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               AutomationProperties.Name="Distance from current location" />
                        <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Button Text="Speak" Command="{Binding SpeakRestaurantCommand}" WidthRequest="{OnIdiom Phone=70, Tablet=80}"
                                    AutomationProperties.Name="Speak restaurant information" />
                            <Button Text="Stop" Command="{Binding StopTtsCommand}" WidthRequest="{OnIdiom Phone=60, Tablet=70}"
                                    AutomationProperties.Name="Stop speaking" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 16" Padding="{StaticResource DefaultMargin}" BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                    <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                        <Label Text="Food Photo" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               AutomationProperties.Name="Food photo section" />
                        <Image Aspect="AspectFill" HeightRequest="{OnIdiom Phone=180, Tablet=200}"
                               AutomationProperties.Name="Restaurant food image">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource ByteArrayToImageSourceConverter}">
                                    <Binding Path="Restaurant.ImageData" />
                                    <Binding Path="Restaurant.ImageName" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Button Text="Take Photo" Command="{Binding TakePhotoCommand}"
                                AutomationProperties.Name="Take photo of food" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 16" Padding="{StaticResource DefaultMargin}" BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                    <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                        <Label Text="About Restaurant" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               AutomationProperties.Name="About restaurant section" />
                        <Label Text="{Binding Restaurant.Description}" FontSize="{DynamicResource DefaultFontSize}"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" LineBreakMode="WordWrap" MaxLines="0"
                               AutomationProperties.Name="Restaurant description" />
                    </VerticalStackLayout>
                </Border>

                <!-- Dishes Section -->
                <Border StrokeShape="RoundRectangle 16" Padding="{StaticResource DefaultMargin}" BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                    <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                        <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Label Text="Menu" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" VerticalOptions="Center"
                                   AutomationProperties.Name="Menu section" />
                            <Button Text="Add Dish" Command="{Binding AddDishCommand}" WidthRequest="{OnIdiom Phone=80, Tablet=90}"
                                    AutomationProperties.Name="Add new dish" />
                        </HorizontalStackLayout>
                        
                        <ScrollView Orientation="Horizontal">
                            <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                                <Picker Title="Category" ItemsSource="{Binding DishCategories}" SelectedItem="{Binding SelectedDishCategory}"
                                        WidthRequest="{OnIdiom Phone=100, Tablet=120}" MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                                        AutomationProperties.Name="Filter dishes by category" />
                            </HorizontalStackLayout>
                        </ScrollView>
                        
                        <CollectionView x:Name="DishListView" ItemsSource="{Binding Dishes}" SelectionMode="Single"
                                        AutomationProperties.Name="Dishes list">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Dish">
                                    <Border StrokeShape="RoundRectangle 8" Padding="{StaticResource MediumMargin}" Margin="0,4">
                                        <Frame.BackgroundColor>
                                            <AppThemeBinding Light="{StaticResource LightSurface}" Dark="{StaticResource DarkSurface}" />
                                        </Frame.BackgroundColor>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                                                <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                                                    <Label Text="{Binding Name}" FontSize="{DynamicResource DefaultFontSize}" FontAttributes="Bold"
                                                           LineBreakMode="WordWrap" MaxLines="1"
                                                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                                                    <Label Text="{Binding DietaryIcons}" FontSize="{DynamicResource SmallFontSize}"
                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryColorLight}}" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Description}" FontSize="{DynamicResource SmallFontSize}"
                                                       LineBreakMode="WordWrap" MaxLines="2"
                                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                                <Label Text="{Binding PriceDisplay}" FontSize="{DynamicResource DefaultFontSize}" FontAttributes="Bold"
                                                       TextColor="{StaticResource PrimaryColor}"
                                                       AutomationProperties.Name="Dish price" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SmallSpacing}">
                                                <ImageButton Source="speaker_icon.png" Command="{Binding Source={x:Reference DishListView}, Path=BindingContext.SpeakDishCommand}"
                                                             CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="{OnIdiom Phone=36, Tablet=40}" HeightRequest="{OnIdiom Phone=36, Tablet=40}"
                                                             AutomationProperties.Name="Speak dish information" />
                                                <ImageButton Source="edit_icon.png" Command="{Binding Source={x:Reference DishListView}, Path=BindingContext.EditDishCommand}"
                                                             CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="{OnIdiom Phone=32, Tablet=36}" HeightRequest="{OnIdiom Phone=32, Tablet=36}"
                                                             AutomationProperties.Name="Edit dish" />
                                                <ImageButton Source="delete_icon.png" Command="{Binding Source={x:Reference DishListView}, Path=BindingContext.DeleteDishCommand}"
                                                             CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="{OnIdiom Phone=32, Tablet=36}" HeightRequest="{OnIdiom Phone=32, Tablet=36}"
                                                             AutomationProperties.Name="Delete dish" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No dishes available for this restaurant" Padding="20" HorizontalOptions="Center"
                                       FontSize="{DynamicResource DefaultFontSize}"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       AutomationProperties.Name="No dishes placeholder" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 16" Padding="{StaticResource DefaultMargin}" BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                    <VerticalStackLayout Spacing="{StaticResource DefaultSpacing}">
                        <Label Text="Write Review" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               AutomationProperties.Name="Write review section" />
                        <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Label Text="Rating:" FontSize="{DynamicResource DefaultFontSize}" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                   AutomationProperties.Name="Rating selector label" />
                            <Picker Title="Select rating"
                                    ItemsSource="{Binding RatingOptions}"
                                    SelectedItem="{Binding SelectedRatingString}"
                                    WidthRequest="100" MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                                    AutomationProperties.Name="Select rating" />
                        </HorizontalStackLayout>
                        <Editor Text="{Binding NewComment}" Placeholder="Share your dining experience..." HeightRequest="80"
                                AutomationProperties.Name="Enter your review comment" />
                        <Button Text="Submit Review" Command="{Binding SubmitCommentCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                AutomationProperties.Name="Submit your review" />
                        <Label Text="{Binding StatusMessage}" FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{StaticResource PrimaryColor}" LineBreakMode="WordWrap" MaxLines="0"
                               AutomationProperties.Name="Review submission status" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 16" Padding="{StaticResource DefaultMargin}" BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                    <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                        <Label Text="User Reviews" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               AutomationProperties.Name="Customer reviews section" />
                        <CollectionView x:Name="ReviewsCollectionView" ItemsSource="{Binding Reviews}"
                                        AutomationProperties.Name="Customer reviews list">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Review">
                                    <VerticalStackLayout Padding="{StaticResource DefaultMargin}">
                                        <Label Text="{Binding UserComment}" FontSize="{DynamicResource DefaultFontSize}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" LineBreakMode="WordWrap" MaxLines="0"
                                               AutomationProperties.Name="Review comment" />
                                        <Label Text="{Binding Rating, StringFormat='{}{0}/5 stars'}"
                                               FontSize="{DynamicResource SmallFontSize}" LineBreakMode="WordWrap" MaxLines="1"
                                               TextColor="#FFD700"
                                               AutomationProperties.Name="Review rating stars" />
                                        <Label Text="{Binding CreatedAt, StringFormat='Posted: {0:yyyy-MM-dd}'}"
                                               FontSize="{DynamicResource ExtraSmallFontSize}" LineBreakMode="WordWrap" MaxLines="1"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                               AutomationProperties.Name="Review post date" />
                                        <BoxView HeightRequest="1" Margin="0,8,0,0">
                                            <BoxView.BackgroundColor>
                                                <AppThemeBinding Light="#DDDDDD" Dark="#444444" />
                                            </BoxView.BackgroundColor>
                                        </BoxView>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No reviews yet, be the first to review!" Padding="20" HorizontalOptions="Center"
                                       FontSize="{DynamicResource DefaultFontSize}" LineBreakMode="WordWrap" MaxLines="0"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       AutomationProperties.Name="No reviews placeholder" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="NoRestaurantView" IsVisible="{Binding Restaurant, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="Center" VerticalOptions="Center" Padding="{StaticResource ExtraLargeMargin}">
            <Label Text="No Restaurant Selected" FontSize="{DynamicResource HeaderFontSize}" FontAttributes="Bold"
                   HorizontalOptions="Center" Margin="0,20,0,10" LineBreakMode="WordWrap" MaxLines="0"
                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                   AutomationProperties.Name="No restaurant selected title" />
            <Label Text="Please select a restaurant from the home page" FontSize="{DynamicResource DefaultFontSize}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" HorizontalOptions="Center" LineBreakMode="WordWrap" MaxLines="0"
                   AutomationProperties.Name="Instructions to select restaurant" />
            <Button Text="Go Back" Margin="0,20,0,0" Command="{Binding GoBackCommand}"
                    AutomationProperties.Name="Navigate back to home page" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>