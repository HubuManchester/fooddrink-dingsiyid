<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             xmlns:converters="clr-namespace:CampusEats.Converters"
             x:Class="CampusEats.Views.DetailPage"
             Title="{Binding Restaurant.Name}"
             x:DataType="viewmodels:DetailPageViewModel">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
    </ContentPage.Resources>

    <Grid>
        <!-- Main content area -->
        <ScrollView IsVisible="{Binding Restaurant, Converter={StaticResource InvertedBoolConverter}, Mode=OneWay}" Opacity="{Binding Restaurant, Converter={StaticResource InvertedBoolConverter}, Mode=OneWay}">
            <VerticalStackLayout Padding="20" Spacing="15">
                <Frame CornerRadius="20" BackgroundColor="White" Padding="15" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="{Binding Restaurant.Name}" FontSize="24" FontAttributes="Bold" 
                           AutomationProperties.Name="Restaurant name" />
                    <Label Text="{Binding Restaurant.Cuisine}" FontSize="16" TextColor="Gray" 
                           AutomationProperties.Name="Cuisine" />
                    <Label Text="{Binding Restaurant.RatingStars}" FontSize="16" TextColor="#FFD700" 
                           AutomationProperties.Name="Rating" />
                    <Label Text="{Binding Restaurant.Distance, StringFormat='📍 {0:F1} km from you'}" FontSize="14" 
                           AutomationProperties.Name="Distance" />
                    <Button Text="🔊 Speak Restaurant Info" Command="{Binding SpeakRestaurantCommand}" Margin="0,10,0,0" 
                            AutomationProperties.Name="Speak restaurant info button" />
                </VerticalStackLayout>
            </Frame>

                <Frame CornerRadius="20" BackgroundColor="White" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="📸 Food Photo" FontSize="16" FontAttributes="Bold" 
                               AutomationProperties.Name="Food photo" />
                        <Image HeightRequest="200" Aspect="AspectFill" AutomationProperties.Name="Restaurant image">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource ByteArrayToImageSourceConverter}">
                                    <Binding Path="Restaurant.ImageData" />
                                    <Binding Path="Restaurant.ImageName" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Button Text="📷 Take Photo" Command="{Binding TakePhotoCommand}" Margin="0,10,0,0" 
                                AutomationProperties.Name="Take photo button" />
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="White" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="ℹ️ About Restaurant" FontSize="16" FontAttributes="Bold" 
                               AutomationProperties.Name="About restaurant" />
                        <Label Text="{Binding Restaurant.Description}" FontSize="14" 
                               AutomationProperties.Name="Restaurant description" />
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="White" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="✍️ Write Review" FontSize="16" FontAttributes="Bold" 
                               AutomationProperties.Name="Write review" />
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Rating:" VerticalOptions="Center" AutomationProperties.Name="Rating label" />
                            <Picker Title="Select rating" 
                                    ItemsSource="{Binding RatingOptions}"
                                    SelectedItem="{Binding SelectedRatingString}"
                                    WidthRequest="100"
                                    AutomationProperties.Name="Rating picker" />
                        </HorizontalStackLayout>
                        <Editor Text="{Binding NewComment}" Placeholder="Share your dining experience..." HeightRequest="80" 
                                AutomationProperties.Name="Comment input" />
                        <Button Text="Submit Review" Command="{Binding SubmitCommentCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" 
                                AutomationProperties.Name="Submit review button" />
                        <Label Text="{Binding StatusMessage}" FontSize="12" 
                               AutomationProperties.Name="Status message" />
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="White" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="💬 User Reviews" FontSize="16" FontAttributes="Bold" 
                               AutomationProperties.Name="User review list" />
                        <CollectionView ItemsSource="{Binding Reviews}" HeightRequest="300"
                                        AutomationProperties.Name="Review list">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Review">
                                    <VerticalStackLayout Padding="10,5">
                                        <Label Text="{Binding UserComment}" FontSize="14" 
                                               AutomationProperties.Name="Review content" />
                                        <Label Text="{Binding Rating, StringFormat='{}{0}/5'}" FontSize="12" 
                                               AutomationProperties.Name="Review rating" />
                                        <Label Text="{Binding CreatedAt, StringFormat='Posted: {0:yyyy-MM-dd}'}" FontSize="10" TextColor="Gray" 
                                               AutomationProperties.Name="Post time" />
                                        <BoxView HeightRequest="1" BackgroundColor="LightGray" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No reviews yet, be the first to review!" Padding="20" HorizontalOptions="Center" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Empty state layout -->
        <VerticalStackLayout IsVisible="{Binding Restaurant, Converter={StaticResource InvertedBoolConverter}}" 
                            HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <Label Text="🍽️" FontSize="64" HorizontalOptions="Center" AutomationProperties.Name="Empty state icon" />
            <Label Text="No Restaurant Selected" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,20,0,10" 
                   AutomationProperties.Name="Empty state title" />
            <Label Text="Please select a restaurant from the home page" FontSize="14" TextColor="Gray" HorizontalOptions="Center" 
                   AutomationProperties.Name="Empty state hint" />
            <Button Text="🏠 Go Back" Margin="0,20,0,0" Command="{Binding GoBackCommand}" 
                    AutomationProperties.Name="Go back button" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
