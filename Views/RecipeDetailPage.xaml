<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:converters="clr-namespace:CampusEats.Converters"
             x:Class="CampusEats.Views.RecipeDetailPage"
             Title="{Binding Recipe.Name}"
             x:DataType="viewmodels:RecipeDetailViewModel">

    <ContentPage.Resources>
        <converters:BoolToFavoriteConverter x:Key="BoolToFavoriteConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Back" Command="{Binding GoBackCommand}" Order="Primary" Priority="0" 
                     AutomationProperties.Name="Navigate back to recipes list" />
    </ContentPage.ToolbarItems>

    <ScrollView MaximumWidthRequest="{OnIdiom Phone=600, Tablet=800}">
        <VerticalStackLayout Padding="{StaticResource LargeMargin}" Spacing="{StaticResource DefaultSpacing}">
            <Frame CornerRadius="{StaticResource ExtraLargeCornerRadius}" Padding="{StaticResource LargeMargin}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                        <Label Text="{Binding Recipe.CategoryIcon}" FontSize="{DynamicResource MediumFontSize}"
                               AutomationProperties.Name="Recipe category icon" />
                        <Label Text="{Binding Recipe.Name}" FontSize="{DynamicResource TitleFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               AutomationProperties.Name="Recipe name" />
                        <ImageButton Source="{Binding Recipe.IsFavorite, Converter={StaticResource BoolToFavoriteConverter}}"
                                WidthRequest="{OnIdiom Phone=40, Tablet=44}" HeightRequest="{OnIdiom Phone=40, Tablet=44}"
                                Command="{Binding ToggleFavoriteCommand}"
                                BackgroundColor="Transparent"
                                AutomationProperties.Name="Toggle recipe favorite status" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Recipe.Category}" FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           AutomationProperties.Name="Recipe category" />
                    <Label Text="{Binding Recipe.RatingStars}" FontSize="{DynamicResource MediumFontSize}"
                           TextColor="#FFD700"
                           AutomationProperties.Name="Recipe rating" />
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="{StaticResource ExtraLargeCornerRadius}" Padding="{StaticResource DefaultMargin}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <Image Source="{Binding Recipe.ImageName}" Aspect="AspectFill"
                       HeightRequest="{OnIdiom Phone=200, Tablet=300}"
                       AutomationProperties.Name="Recipe image" />
            </Frame>

            <Frame CornerRadius="{StaticResource ExtraLargeCornerRadius}" Padding="{StaticResource DefaultMargin}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <HorizontalStackLayout Spacing="{StaticResource LargeSpacing}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Calories" FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                               HorizontalOptions="Center"
                               AutomationProperties.Name="Calories label" />
                        <Label Text="{Binding Recipe.Calories}" FontSize="{DynamicResource HeaderFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               HorizontalOptions="Center"
                               AutomationProperties.Name="Calories value" />
                    </VerticalStackLayout>
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Prep Time" FontSize="{DynamicResource SmallFontSize}"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                               HorizontalOptions="Center"
                               AutomationProperties.Name="Preparation time label" />
                        <Label Text="{Binding Recipe.PrepTime, StringFormat='{}{0} min'}" FontSize="{DynamicResource HeaderFontSize}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               HorizontalOptions="Center"
                               AutomationProperties.Name="Preparation time value" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <Frame CornerRadius="{StaticResource ExtraLargeCornerRadius}" Padding="{StaticResource DefaultMargin}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    <Label Text="Description" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Description section" />
                    <Label Text="{Binding Recipe.Description}" FontSize="{DynamicResource DefaultFontSize}"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Recipe description" />
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="{StaticResource ExtraLargeCornerRadius}" Padding="{StaticResource DefaultMargin}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    <Label Text="Ingredients" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Ingredients section" />
                    <Label Text="{Binding IngredientsDisplay}" FontSize="{DynamicResource DefaultFontSize}"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Recipe ingredients list" />
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="{StaticResource ExtraLargeCornerRadius}" Padding="{StaticResource DefaultMargin}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    <Label Text="Instructions" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Cooking instructions section" />
                    <Label Text="{Binding InstructionsDisplay}" FontSize="{DynamicResource DefaultFontSize}"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Step by step cooking instructions" />
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                <Button Text="Add to Shopping List" Command="{Binding AddToShoppingListCommand}"
                        BackgroundColor="#2ECC71" TextColor="White"
                        MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                        AutomationProperties.Name="Add ingredients to shopping list" />
                <Button Text="Add to Meal Plan" Command="{Binding AddToMealPlanCommand}"
                        BackgroundColor="#3498DB" TextColor="White"
                        MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                        AutomationProperties.Name="Add recipe to meal plan" />
            </HorizontalStackLayout>

            <Button Text="Speak Recipe" Command="{Binding SpeakRecipeCommand}"
                    BackgroundColor="{StaticResource SecondaryColor}" TextColor="White"
                    MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                    AutomationProperties.Name="Read recipe aloud using text to speech" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>