<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:converters="clr-namespace:CampusEats.Converters"
             x:Class="CampusEats.Views.RecipeDetailPage"
             Title="{Binding Recipe.Name}"
             x:DataType="viewmodels:RecipeDetailViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToFavoriteConverter x:Key="BoolToFavoriteConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Recipe title -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="{Binding Recipe.CategoryIcon}" FontSize="24" />
                        <Label Text="{Binding Recipe.Name}" FontSize="24" FontAttributes="Bold" />
                        <Button Text="{Binding Recipe.IsFavorite, Converter={StaticResource BoolToFavoriteConverter}}" 
                                WidthRequest="32" HeightRequest="32"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Recipe.Category}" FontSize="16" TextColor="Gray" />
                    <Label Text="{Binding Recipe.RatingStars}" FontSize="16" TextColor="#FFD700" />
                </VerticalStackLayout>
            </Frame>

            <!-- Image -->
            <Frame CornerRadius="20" Padding="15">
                <Image Source="{Binding Recipe.ImageName}" HeightRequest="200" Aspect="AspectFill" />
            </Frame>

            <!-- Nutrition info -->
            <Frame CornerRadius="20" Padding="15">
                <HorizontalStackLayout Spacing="20">
                    <VerticalStackLayout>
                        <Label Text="🔥" FontSize="24" />
                        <Label Text="Calories" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Recipe.Calories}" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="⏱️" FontSize="24" />
                        <Label Text="Prep Time" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Recipe.PrepTime, StringFormat='{}{0} min'}" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Description -->
            <Frame CornerRadius="20" Padding="15">
                <VerticalStackLayout>
                    <Label Text="📝 Description" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Recipe.Description}" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <!-- Ingredients -->
            <Frame CornerRadius="20" Padding="15">
                <VerticalStackLayout>
                    <Label Text="🥗 Ingredients" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding IngredientsDisplay}" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <!-- Steps -->
            <Frame CornerRadius="20" Padding="15">
                <VerticalStackLayout>
                    <Label Text="👩🍳 Instructions" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding InstructionsDisplay}" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <!-- Speak button -->
            <Button Text="🔊 Speak Recipe" Command="{Binding SpeakRecipeCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
