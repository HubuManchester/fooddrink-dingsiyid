<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             x:Class="CampusEats.Views.MealPlanPage"
             x:Name="MealPlanPageView"
             Title="Meal Plan"
             x:DataType="viewmodels:MealPlanViewModel">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
        <!-- Header Section with solid color background -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource PrimaryColor}" Padding="16">
            <VerticalStackLayout>
                <Label Text="🥗 My Meal Plan" FontSize="24" FontAttributes="Bold" TextColor="White"
                       AutomationProperties.Name="Meal plan page title" />
                <DatePicker x:Name="DatePicker"
                            Date="{Binding SelectedDate}"
                            Format="MMMM dd, yyyy"
                            Margin="0, 8, 0, 0"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            MinimumHeightRequest="44"
                            AutomationProperties.Name="Select date for meal plan" />
            </VerticalStackLayout>
        </Grid>

        <!-- Summary Section -->
        <Grid Grid.Row="1" Margin="16" ColumnDefinitions="*, *, *" VerticalOptions="Center">
            <Button Grid.Column="0" Text="📅 Today" Command="{Binding GoToTodayCommand}"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="14"
                    MinimumHeightRequest="44"
                    AutomationProperties.Name="Go to today" />
            <Button Grid.Column="1" Text="← Prev" Command="{Binding PreviousDayCommand}"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="14"
                    MinimumHeightRequest="44"
                    AutomationProperties.Name="Previous day" />
            <Button Grid.Column="2" Text="Next →" Command="{Binding NextDayCommand}"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="14"
                    MinimumHeightRequest="44"
                    AutomationProperties.Name="Next day" />
        </Grid>

        <!-- Add Meal Button -->
        <Button Grid.Row="2" Text="+ Add Meal"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding AddMealCommand}"
                FontSize="14"
                WidthRequest="200"
                HeightRequest="50"
                Margin="16"
                AutomationProperties.Name="Add meal to plan" />

        <!-- Meal List -->
        <RefreshView Grid.Row="3" Margin="16" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="12"
                                        IsVisible="{Binding MealPlans.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Label Text="Total Calories:" FontSize="14" 
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TotalCalories, StringFormat='{}{0} kcal'}" 
                               FontSize="28" FontAttributes="Bold" 
                               TextColor="{StaticResource AccentOrange}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding MealPlans}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MealPlanItem">
                                <Border StrokeShape="RoundRectangle 8" Padding="12" Margin="0, 4"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding RecipeName}" FontSize="16" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                                   AutomationProperties.Name="Meal recipe name" />
                                            <Label FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                   AutomationProperties.Name="Meal planned date">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Date: " />
                                                        <Span Text="{Binding PlannedDate, StringFormat='{}{0:MMM dd, yyyy}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding MealType, StringFormat='Meal Type: {0}'}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                   AutomationProperties.Name="Meal type" />
                                            <Label Text="{Binding Calories, StringFormat='Calories: {0} kcal'}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                   AutomationProperties.Name="Meal calories" />
                                        </VerticalStackLayout>

                                        <Grid Grid.Column="1" RowSpan="2" ColumnDefinitions="Auto, Auto" VerticalOptions="Center" ColumnSpacing="8">
                                            <Button Text="✏️ Edit"
                                                    FontSize="12"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    BackgroundColor="{StaticResource LightPrimary}"
                                                    CornerRadius="8"
                                                    BorderWidth="1"
                                                    BorderColor="{StaticResource PrimaryColor}"
                                                    Command="{Binding Source={x:Reference MealPlanPageView}, Path=BindingContext.EditMealCommand}"
                                                    CommandParameter="{Binding .}"
                                                    WidthRequest="70" 
                                                    HeightRequest="44"
                                                    Padding="8,4"
                                                    MinimumHeightRequest="44"
                                                    AutomationProperties.Name="Edit meal" />
                                            <Button Text="🗑️ Delete"
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    TextColor="White"
                                                    BackgroundColor="{StaticResource ErrorColor}"
                                                    CornerRadius="8"
                                                    Command="{Binding Source={x:Reference MealPlanPageView}, Path=BindingContext.RemoveMealCommand}"
                                                    CommandParameter="{Binding .}"
                                                    WidthRequest="70" 
                                                    HeightRequest="44"
                                                    Padding="8,4"
                                                    MinimumHeightRequest="44"
                                                    AutomationProperties.Name="Delete meal" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Empty State -->
                    <VerticalStackLayout Padding="24" HorizontalOptions="Center" VerticalOptions="Center"
                                        IsVisible="{Binding MealPlans.Count, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" 
                                StrokeShape="RoundRectangle 16" Padding="24">
                            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                                <Label Text="🍽️ No meals planned" FontSize="20" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                       HorizontalOptions="Center"
                                       AutomationProperties.Name="No meals planned message" />
                                <Label Text="Tap the + Add Meal button to add your first meal" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       HorizontalOptions="Center"
                                       AutomationProperties.Name="Add meal instruction" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Tab Bar Spacer -->
        <BoxView Grid.Row="4" HeightRequest="0" />
    </Grid>
</ContentPage>