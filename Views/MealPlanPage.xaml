<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             x:Class="CampusEats.Views.MealPlanPage"
             x:Name="MealPlanPageView"
             Title="Meal Plan"
             x:DataType="viewmodels:MealPlanViewModel">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
        <!-- Header Section -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource SecondaryColor}" Padding="{StaticResource LargeMargin}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource SecondaryColor}" Offset="0" />
                    <GradientStop Color="{StaticResource PrimaryColor}" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout>
                <Label Text="🥗 My Meal Plan" FontSize="{DynamicResource TitleFontSize}" FontAttributes="Bold" TextColor="White"
                       AutomationProperties.Name="Meal plan page title" />
                <DatePicker x:Name="DatePicker"
                            Date="{Binding SelectedDate}"
                            Format="MMMM dd, yyyy"
                            Margin="0, 8, 0, 0"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                            AutomationProperties.Name="Select date for meal plan" />
            </VerticalStackLayout>
        </Grid>

        <!-- Action Bar -->
        <HorizontalStackLayout Grid.Row="1" Margin="{StaticResource LargeMargin}" Spacing="{StaticResource DefaultSpacing}" VerticalOptions="Center">
            <Picker
                    Title="Meal Type"
                    ItemsSource="{Binding MealTypes}"
                    SelectedItem="{Binding MealType}"
                    WidthRequest="{OnIdiom Phone=120, Tablet=150}"
                    MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                    AutomationProperties.Name="Select meal type" />
            <Button Text="+ Add Meal"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding AddMealCommand}"
                    AutomationProperties.Name="Add meal to plan" />
        </HorizontalStackLayout>

        <!-- Calories Card -->
        <Frame Grid.Row="2"
               CornerRadius="16"
               Padding="{StaticResource LargeMargin}"
               Margin="{StaticResource LargeMargin}"
               HasShadow="True" 
               BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="{StaticResource DefaultSpacing}">
                <Label Text="🔥 Daily Calories:" FontSize="{DynamicResource MediumFontSize}"
                       TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                       AutomationProperties.Name="Daily calories consumed" />
                <Label Text="{Binding TotalCalories}" FontSize="{DynamicResource HeaderFontSize}" FontAttributes="Bold"
                       TextColor="{StaticResource AccentOrange}"
                       AutomationProperties.Name="Total calories value" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Meal List -->
        <RefreshView Grid.Row="3" Margin="{StaticResource MediumMargin}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding MealPlanItems}"
                            AutomationProperties.Name="Meal plan items list">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MealPlanItem">
                        <Border StrokeShape="RoundRectangle 16"
                               Margin="0, 0, 0, 16"
                               Padding="0"
                               BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}">
                            <Grid Padding="{StaticResource DefaultMargin}" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding RecipeName}" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                               AutomationProperties.Name="Recipe name" />
                                        <Label FontSize="{DynamicResource SmallFontSize}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                               AutomationProperties.Name="Meal type and date">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding MealType}" />
                                                    <Span Text=" - " />
                                                    <Span Text="{Binding PlannedDate, StringFormat='{}{0:MMM dd}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Grid Grid.Column="1" RowSpan="2" ColumnDefinitions="Auto, Auto" VerticalOptions="Center" ColumnSpacing="{StaticResource SmallSpacing}">
                                        <Button Text="✏️ Edit"
                                                FontSize="{OnIdiom Phone=11, Tablet=13}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                BackgroundColor="{StaticResource LightPrimary}"
                                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                                BorderWidth="1"
                                                BorderColor="{StaticResource PrimaryColor}"
                                                Command="{Binding Source={x:Reference MealPlanPageView}, Path=BindingContext.EditMealCommand}"
                                                CommandParameter="{Binding .}"
                                                WidthRequest="{OnIdiom Phone=70, Tablet=80}" 
                                                HeightRequest="{OnIdiom Phone=44, Tablet=50}"
                                                Padding="8,4"
                                                MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                                                AutomationProperties.Name="Edit meal" />
                                        <Button Text="🗑️ Delete"
                                                Grid.Column="1"
                                                FontSize="{OnIdiom Phone=11, Tablet=13}"
                                                TextColor="White"
                                                BackgroundColor="{StaticResource ErrorColor}"
                                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                                Command="{Binding Source={x:Reference MealPlanPageView}, Path=BindingContext.RemoveMealCommand}"
                                                CommandParameter="{Binding .}"
                                                WidthRequest="{OnIdiom Phone=70, Tablet=80}" 
                                                HeightRequest="{OnIdiom Phone=44, Tablet=50}"
                                                Padding="8,4"
                                                MinimumHeightRequest="{StaticResource ButtonMinHeight}"
                                                AutomationProperties.Name="Remove meal from plan" />
                                    </Grid>
                                    <Label Grid.Column="0" Grid.Row="2" FontSize="{DynamicResource SmallFontSize}"
                                           TextColor="{StaticResource PrimaryColor}"
                                           AutomationProperties.Name="Calories">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="🍎 " />
                                                <Span Text="{Binding Calories}" />
                                                <Span Text=" calories" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="{StaticResource ExtraLargeMargin}" HorizontalOptions="Center" VerticalOptions="Center">
                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" 
                               CornerRadius="16" 
                               Padding="{StaticResource ExtraLargeMargin}">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="🍳" FontSize="64" HorizontalOptions="Center" Margin="0,0,0,16" />
                                <Label Text="No Meals Planned" FontSize="{DynamicResource HeaderFontSize}" HorizontalOptions="Center" FontAttributes="Bold"
                                       LineBreakMode="WordWrap" MaxLines="0">
                                    <Label.TextColor>
                                        <AppThemeBinding Light="{StaticResource LightText}" Dark="{StaticResource DarkText}" />
                                    </Label.TextColor>
                                </Label>
                                <Label Text="Tap + Add Meal to create your first meal plan" 
                                       FontSize="{DynamicResource DefaultFontSize}"
                                       HorizontalOptions="Center" LineBreakMode="WordWrap" MaxLines="0" Margin="0,8,0,0">
                                    <Label.TextColor>
                                        <AppThemeBinding Light="{StaticResource LightTextSecondary}" Dark="{StaticResource DarkTextSecondary}" />
                                    </Label.TextColor>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <StackLayout Grid.Row="4" HeightRequest="20"/>
    </Grid>
</ContentPage>
