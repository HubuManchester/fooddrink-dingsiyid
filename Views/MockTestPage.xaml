<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:models="clr-namespace:CampusEats.Models"
             xmlns:converters="clr-namespace:CampusEats.Converters"
             x:Class="CampusEats.Views.MockTestPage"
             Title="Mock Function Test"
             x:DataType="viewmodels:MockTestViewModel">

    <ScrollView MaximumWidthRequest="{OnIdiom Phone=600, Tablet=800}">
        <VerticalStackLayout Padding="{StaticResource LargeMargin}" Spacing="{StaticResource DefaultSpacing}">
            <Frame CornerRadius="{StaticResource LargeCornerRadius}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    <Label Text="Mock Function Switch" FontSize="{DynamicResource HeaderFontSize}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Mock function switch section" />
                    <HorizontalStackLayout>
                        <Label Text="Enable mock data" FontSize="{DynamicResource DefaultFontSize}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                               AutomationProperties.Name="Enable mock data label" />
                        <Switch IsToggled="{Binding IsMockEnabled}" VerticalOptions="Center"
                                AutomationProperties.Name="Toggle mock data enabled" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding StatusMessage}"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           AutomationProperties.Name="Current status message" />
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="{StaticResource LargeCornerRadius}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    <Label Text="Mock Photo Recognition" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Photo recognition section" />
                    <Button Text="Simulate photo and recognize food"
                            Command="{Binding MockCaptureCommand}"
                            IsEnabled="{Binding IsMockEnabled}"
                            AutomationProperties.Name="Simulate photo capture and food recognition" />

                    <Label Text="Recognition result:" FontSize="{DynamicResource SmallFontSize}" FontAttributes="Bold"
                           IsVisible="{Binding HasRecognitionResult}"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Recognition result header" />
                    <Frame IsVisible="{Binding HasRecognitionResult}"
                           BackgroundColor="{AppThemeBinding Light=#FFF8F0, Dark=#2d2d2d}"
                           CornerRadius="{StaticResource DefaultCornerRadius}"
                           Padding="{StaticResource DefaultMargin}">
                        <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Label Text="{Binding RecognizedFoodName}"
                                   FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                   AutomationProperties.Name="Recognized food name" />
                            <Label Text="{Binding RecognizedCategory}"
                                   FontSize="{DynamicResource SmallFontSize}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                   AutomationProperties.Name="Recognized food category" />
                            <Label Text="{Binding RecognizedCalories, StringFormat='Calories: {0} kcal'}"
                                   FontSize="{DynamicResource SmallFontSize}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                   AutomationProperties.Name="Recognized food calories" />
                            <Label Text="{Binding RecognizedDescription}"
                                   FontSize="{DynamicResource ExtraSmallFontSize}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                   AutomationProperties.Name="Recognized food description" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="{StaticResource LargeCornerRadius}">
                <Frame.BackgroundColor>
                    <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                </Frame.BackgroundColor>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    <Label Text="Mock Location" FontSize="{DynamicResource MediumFontSize}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Location section" />
                    <Button Text="Get current location"
                            Command="{Binding MockLocationCommand}"
                            IsEnabled="{Binding IsMockEnabled}"
                            AutomationProperties.Name="Get current mock location" />

                    <Label Text="{Binding CurrentLocation, StringFormat='Current location: {0}'}"
                           IsVisible="{Binding HasLocation}"
                           FontSize="{DynamicResource SmallFontSize}"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                           AutomationProperties.Name="Current location coordinates" />

                    <Button Text="Get nearby restaurants"
                            Command="{Binding MockNearbyRestaurantsCommand}"
                            IsEnabled="{Binding IsMockEnabled}"
                            AutomationProperties.Name="Get nearby restaurants using mock location" />

                    <CollectionView ItemsSource="{Binding NearbyRestaurants}"
                                    IsVisible="{Binding HasNearbyRestaurants}"
                                    HeightRequest="{OnIdiom Phone=300, Tablet=450}"
                                    AutomationProperties.Name="Nearby restaurants list sorted by distance">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Restaurant">
                                <Frame CornerRadius="{StaticResource DefaultCornerRadius}"
                                       Margin="{StaticResource SmallMargin}"
                                       Padding="{StaticResource DefaultMargin}">
                                    <Frame.BackgroundColor>
                                        <AppThemeBinding Light="{StaticResource LightCard}" Dark="{StaticResource DarkCard}" />
                                    </Frame.BackgroundColor>
                                    <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"
                                               FontSize="{DynamicResource DefaultFontSize}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                               AutomationProperties.Name="Restaurant name" />
                                        <Label Text="{Binding Cuisine, StringFormat='Cuisine: {0}'}"
                                               FontSize="{DynamicResource SmallFontSize}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                               AutomationProperties.Name="Restaurant cuisine type" />
                                        <Label Text="{Binding Distance, StringFormat='Distance: {0:F2} km'}"
                                               FontSize="{DynamicResource SmallFontSize}"
                                               TextColor="{StaticResource PrimaryColor}"
                                               AutomationProperties.Name="Distance from location" />
                                        <Label Text="{Binding RatingStars, StringFormat='Rating: {0}'}"
                                               FontSize="{DynamicResource SmallFontSize}"
                                               TextColor="#FFD700"
                                               AutomationProperties.Name="Restaurant rating" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>