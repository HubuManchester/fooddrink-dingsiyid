<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             x:Class="CampusEats.Views.AccessibilityPage"
             Title="Accessibility Settings"
             x:DataType="viewmodels:AccessibilityViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Accessibility Settings" FontSize="24" FontAttributes="Bold" />
            
            <Border StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Theme Mode" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding ThemeDisplayName}" FontSize="16" />
                    <Button Text="Toggle Theme" Command="{Binding ToggleThemeCommand}" 
                            FontSize="14" WidthRequest="120" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Font Size" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding FontScaleDisplay}" FontSize="16" />
                    <Slider Minimum="0.8" Maximum="2.0" Value="{Binding FontScale, Mode=TwoWay}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="A-" Command="{Binding DecreaseFontCommand}" 
                                FontSize="16" WidthRequest="60" HeightRequest="44" />
                        <Button Text="A+" Command="{Binding IncreaseFontCommand}" 
                                FontSize="16" WidthRequest="60" HeightRequest="44" />
                        <Button Text="Reset" Command="{Binding ResetFontCommand}" 
                                FontSize="14" WidthRequest="70" HeightRequest="44" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Text-to-Speech" FontSize="18" FontAttributes="Bold" />
                    <Button Text="🔊 Test Speech" Command="{Binding TestTtsCommand}" 
                            FontSize="14" WidthRequest="130" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Vibration Feedback" FontSize="18" FontAttributes="Bold" />
                    <Button Text="Test Vibration" Command="{Binding TestVibrationCommand}" 
                            FontSize="14" WidthRequest="130" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="WCAG Guidelines" FontSize="18" FontAttributes="Bold" />
                    <Label Text="This app follows WCAG 2.1 AA accessibility standards." FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>