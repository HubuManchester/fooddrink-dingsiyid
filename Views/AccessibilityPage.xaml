<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             x:Class="CampusEats.Views.AccessibilityPage"
             Title="Accessibility Settings"
             x:DataType="viewmodels:AccessibilityViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Page title -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout>
                    <Label Text="♿ Accessibility Settings" FontSize="24" FontAttributes="Bold" />
                    <Label Text="For a better user experience" FontSize="14" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Theme mode -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🎨 Theme Mode" FontSize="18" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{Binding ThemeDisplayName}" FontSize="16" />
                        <Button Text="Toggle" Command="{Binding ToggleThemeCommand}" WidthRequest="80" />
                    </Grid>
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="☀️ Light" Command="{Binding SetLightThemeCommand}" />
                        <Button Text="🌙 Dark" Command="{Binding SetDarkThemeCommand}" />
                        <Button Text="🔄 System" Command="{Binding SetSystemThemeCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Font size -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📝 Font Size" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding FontScaleDisplay}" FontSize="16" />
                    <Slider 
                        Minimum="0.8" 
                        Maximum="2.0" 
                        Value="{Binding FontScale, Mode=TwoWay}" 
                        Margin="0,10,0,0" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="A-" Command="{Binding DecreaseFontCommand}" />
                        <Button Text="A+" Command="{Binding IncreaseFontCommand}" />
                        <Button Text="Reset" Command="{Binding ResetFontCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Text to speech -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🔊 Text-to-Speech" FontSize="18" FontAttributes="Bold" />
                    <Switch IsToggled="{Binding TtsEnabled}" />
                    <Slider 
                        Minimum="0.5" 
                        Maximum="2.0" 
                        Value="{Binding TtsSpeed, Mode=TwoWay}" 
                        Margin="0,10,0,0" />
                    <Label Text="Speed: {Binding TtsSpeed, StringFormat='{0:F1}x'}" FontSize="14" />
                    <Button Text="🔊 Test Speech" Command="{Binding TestTtsCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Vibration feedback -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📳 Vibration Feedback" FontSize="18" FontAttributes="Bold" />
                    <Switch IsToggled="{Binding VibrationEnabled}" />
                    <Button Text="Test Vibration" Command="{Binding TestVibrationCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Accessibility guidelines -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📖 WCAG Accessibility Guidelines" FontSize="18" FontAttributes="Bold" />
                    
                    <Label Text="1. Perceivable" FontSize="16" FontAttributes="Bold" TextColor="#FF6B35" />
                    <Label Text="   - Information and user interface components must be presented to users in ways they can perceive" FontSize="14" />
                    
                    <Label Text="2. Operable" FontSize="16" FontAttributes="Bold" TextColor="#FF6B35" />
                    <Label Text="   - User interface components and navigation must be operable" FontSize="14" />
                    
                    <Label Text="3. Understandable" FontSize="16" FontAttributes="Bold" TextColor="#FF6B35" />
                    <Label Text="   - Information and the operation of user interface must be understandable" FontSize="14" />
                    
                    <Label Text="4. Robust" FontSize="16" FontAttributes="Bold" TextColor="#FF6B35" />
                    <Label Text="   - Content must be robust enough to be interpreted reliably by a wide variety of user agents" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <!-- Contrast information -->
            <Frame CornerRadius="20" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🎯 Contrast Standards" FontSize="18" FontAttributes="Bold" />
                    <Label Text="This app follows WCAG 2.1 AA standards:" FontSize="14" />
                    <Label Text="• Normal text contrast ≥ 4.5:1" FontSize="14" />
                    <Label Text="• Large text contrast ≥ 3:1" FontSize="14" />
                    <Label Text="• Icons and graphics contrast ≥ 3:1" FontSize="14" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
