<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             xmlns:converters="clr-namespace:CampusEats.Converters"
             x:Class="CampusEats.Views.CrudTestPage"
             Title="Database CRUD Test"
             x:DataType="viewmodels:CrudTestViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#FF6B35</Color>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotNullToBoolConverter x:Key="StringNotNullToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">
            
            <!-- Header -->
            <Frame CornerRadius="15" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="🗄️" FontSize="28" VerticalOptions="Center"/>
                        <Label Text="Database CRUD Test" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="{Binding StatusMessage}" TextColor="Gray" FontSize="12" Margin="0,5,0,0"/>
                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                        <Button Text="📥 Load All Data" Command="{Binding LoadAllDataCommand}" 
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
                        <Button Text="🔄 Reset All Data" Command="{Binding ResetAllDataCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="IndianRed"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Restaurant CRUD Section -->
            <Frame CornerRadius="15" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🏪 Restaurant CRUD" FontSize="18" FontAttributes="Bold"/>
                    
                    <!-- Add Form -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3D3D3D}" CornerRadius="10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Add New Restaurant" FontAttributes="Bold"/>
                            <Entry Placeholder="Restaurant Name" Text="{Binding NewRestaurantName}"/>
                            <Entry Placeholder="Cuisine Type" Text="{Binding NewRestaurantCuisine}"/>
                            <Slider Minimum="1" Maximum="5" Value="{Binding NewRestaurantRating}"/>
                            <Label Text="{Binding NewRestaurantRating, StringFormat='Rating: {0:F1}'}" FontSize="12"/>
                            <Editor Placeholder="Description" Text="{Binding NewRestaurantDescription}" HeightRequest="60"/>
                            <Button Text="Add Restaurant" Command="{Binding AddRestaurantCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Restaurant List -->
                    <Label Text="Restaurants:" FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding Restaurants}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedRestaurant}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="10" Margin="5" Padding="10"
                                       BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/>
                                        <Label Text="{Binding Cuisine}" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding RatingStars}" FontSize="14"/>
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="Gray" MaxLines="2"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Restaurant Actions -->
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Update Selected" Command="{Binding UpdateRestaurantCommand}"
                                IsEnabled="{Binding SelectedRestaurant, Converter={StaticResource StringNotNullToBoolConverter}}"/>
                        <Button Text="Delete Selected" Command="{Binding DeleteRestaurantCommand}"
                                IsEnabled="{Binding SelectedRestaurant, Converter={StaticResource StringNotNullToBoolConverter}}"
                                BackgroundColor="IndianRed"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Review CRUD Section -->
            <Frame CornerRadius="15" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💬 Review CRUD" FontSize="18" FontAttributes="Bold"/>
                    
                    <!-- Add Review Form -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3D3D3D}" CornerRadius="10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Add New Review (select restaurant first)" FontAttributes="Bold"/>
                            <Entry Placeholder="Your Comment" Text="{Binding NewReviewComment}"/>
                            <Slider Minimum="1" Maximum="5" Value="{Binding NewReviewRating}"/>
                            <Label Text="{Binding NewReviewRating, StringFormat='Rating: {0}'}" FontSize="12"/>
                            <Button Text="Add Review" Command="{Binding AddReviewCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Review List -->
                    <Label Text="Reviews for selected restaurant:" FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding Reviews}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedReview}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="10" Margin="5" Padding="10"
                                       BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding UserComment}" FontSize="14"/>
                                        <Label Text="{Binding Rating, StringFormat='Rating: {0}/5'}" FontSize="12" TextColor="{StaticResource PrimaryColor}"/>
                                        <Label Text="{Binding CreatedAt, StringFormat='Posted: {0:MM/dd/yyyy HH:mm}'}" FontSize="10" TextColor="Gray"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Review Actions -->
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Update Selected" Command="{Binding UpdateReviewCommand}"
                                IsEnabled="{Binding SelectedReview, Converter={StaticResource StringNotNullToBoolConverter}}"/>
                        <Button Text="Delete Selected" Command="{Binding DeleteReviewCommand}"
                                IsEnabled="{Binding SelectedReview, Converter={StaticResource StringNotNullToBoolConverter}}"
                                BackgroundColor="IndianRed"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Recipe CRUD Section -->
            <Frame CornerRadius="15" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📝 Recipe CRUD" FontSize="18" FontAttributes="Bold"/>
                    
                    <!-- Recipe List -->
                    <Label Text="Recipes:" FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding Recipes}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedRecipe}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="10" Margin="5" Padding="10"
                                       BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/>
                                        <Label Text="{Binding Category}" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding Rating, StringFormat='Rating: {0:F1}'}" FontSize="12"/>
                                        <Label Text="{Binding Calories, StringFormat='Calories: {0} kcal'}" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Recipe Actions -->
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Add Test Recipe" Command="{Binding AddRecipeCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
                        <Button Text="Delete Selected" Command="{Binding DeleteRecipeCommand}"
                                IsEnabled="{Binding SelectedRecipe, Converter={StaticResource StringNotNullToBoolConverter}}"
                                BackgroundColor="IndianRed"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
