<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusEats.ViewModels"
             x:Class="CampusEats.Views.HardwareTestPage"
             x:Name="HardwareTestPageView"
             Title="Hardware Test"
             x:DataType="viewmodels:HardwareTestViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Hardware Test Center" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            
            <Border StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Test Status" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding StatusMessage}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Camera Recognition" FontSize="18" FontAttributes="Bold" />
                    <Button Text="📷 Take Photo &amp; Recognize"
                            Command="{Binding CaptureAndRecognizeCommand}"
                            FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                            WidthRequest="{OnIdiom Phone=200, Tablet=240, Desktop=260}"
                            HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    
                    <Border StrokeShape="RoundRectangle 8" Padding="15" IsVisible="{Binding HasRecognitionResult}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding RecognizedFoodName}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding RecognizedFoodInfo}" FontSize="14" />
                            <Image Source="{Binding RecognizedFoodImage}" HeightRequest="150" Aspect="AspectFill" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Shake Detection" FontSize="18" FontAttributes="Bold" />
                    <Button Text="🎲 Shake &amp; Recommend"
                            Command="{Binding ShakeAndRecommendCommand}"
                            FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                            WidthRequest="{OnIdiom Phone=200, Tablet=240, Desktop=260}"
                            HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    
                    <Border StrokeShape="RoundRectangle 8" Padding="15" IsVisible="{Binding HasShakeResult}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ShakeRecipeName}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding ShakeRecipeInfo}" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Text-to-Speech" FontSize="18" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button Text="🔊 Speak" Command="{Binding TestSpeechCommand}" 
                                FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                                WidthRequest="{OnIdiom Phone=100, Tablet=120, Desktop=130}"
                                HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                                VerticalOptions="Center" />
                        <Button Text="🔇 Stop" Command="{Binding StopSpeechCommand}" 
                                FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                                WidthRequest="{OnIdiom Phone=100, Tablet=120, Desktop=130}"
                                HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Vibration" FontSize="18" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button Text="⚡ Short" Command="{Binding VibrateShortCommand}" 
                                FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                                WidthRequest="{OnIdiom Phone=80, Tablet=90, Desktop=100}"
                                HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                                VerticalOptions="Center" />
                        <Button Text="⚡ Medium" Command="{Binding VibrateMediumCommand}" 
                                FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                                WidthRequest="{OnIdiom Phone=90, Tablet=100, Desktop=110}"
                                HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                                VerticalOptions="Center" />
                        <Button Text="⚡ Long" Command="{Binding VibrateLongCommand}" 
                                FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                                WidthRequest="{OnIdiom Phone=80, Tablet=90, Desktop=100}"
                                HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Location" FontSize="18" FontAttributes="Bold" />
                    <Button Text="📍 Get Current Location"
                            Command="{Binding GetLocationCommand}"
                            FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=14}"
                            WidthRequest="{OnIdiom Phone=180, Tablet=220, Desktop=240}"
                            HeightRequest="{OnIdiom Phone=50, Tablet=56, Desktop=50}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    
                    <Border StrokeShape="RoundRectangle 8" Padding="15" IsVisible="{Binding HasLocation}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Current Location" FontSize="16" FontAttributes="Bold" />
                            <Label FontSize="14">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Latitude: " />
                                        <Span Text="{Binding CurrentLatitude, StringFormat='{}{0:F6}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="14">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Longitude: " />
                                        <Span Text="{Binding CurrentLongitude, StringFormat='{}{0:F6}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Text="🚀 Run All Hardware Tests"
                    Command="{Binding RunAllTestsCommand}"
                    FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=16}"
                    WidthRequest="{OnIdiom Phone=220, Tablet=260, Desktop=280}"
                    HeightRequest="{OnIdiom Phone=56, Tablet=60, Desktop=56}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>