<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CampusEats.Views"
       x:Class="CampusEats.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent 
            Title="Restaurants" 
            Icon="🍽️"
            ContentTemplate="{DataTemplate views:MainPage}" 
            Route="mainpage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="🍽️" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent 
            Title="Recipes" 
            Icon="📖"
            ContentTemplate="{DataTemplate views:RecipePage}" 
            Route="recipepage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="📖" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent 
            Title="Accessibility" 
            Icon="♿"
            ContentTemplate="{DataTemplate views:AccessibilityPage}" 
            Route="accessibilitypage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="♿" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent 
            Title="Mock Test" 
            Icon="🎮"
            ContentTemplate="{DataTemplate views:MockTestPage}" 
            Route="mocktestpage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="🎮" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent 
            Title="Location Test" 
            Icon="🧪"
            ContentTemplate="{DataTemplate views:LocationTestPage}" 
            Route="locationtestpage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="🧪" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent 
            Title="CRUD Test" 
            Icon="🗄️"
            ContentTemplate="{DataTemplate views:CrudTestPage}" 
            Route="crudtestpage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="🗄️" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

    <ShellContent Title="Restaurant Details" Route="detailpage" ContentTemplate="{DataTemplate views:DetailPage}" />
    <ShellContent Title="Recipe Details" Route="recipecdetailpage" ContentTemplate="{DataTemplate views:RecipeDetailPage}" />

</Shell>
