<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Warm Peach & Pink Theme - Beautiful Food Colors -->
    
    <!-- Primary Colors - Soft Peach / Light Orange -->
    <Color x:Key="PrimaryColor">#FFB39D</Color>       <!-- Warm Light Peach -->
    <Color x:Key="PrimaryColorDark">#FF9A7A</Color>  <!-- Warm Orange-Peach -->
    <Color x:Key="PrimaryColorLight">#FFE8DF</Color> <!-- Very Soft Peach -->
    <Color x:Key="LightPrimary">#FFF5F0</Color>      <!-- Pale Peach Background -->

    <!-- Secondary Colors - Soft Pink -->
    <Color x:Key="SecondaryColor">#FFC2D1</Color>    <!-- Soft Blush Pink -->
    <Color x:Key="SecondaryColorDark">#FFA5B8</Color><!-- Warm Pink -->
    <Color x:Key="SecondaryColorLight">#FFE8EF</Color><!-- Pale Pink -->

    <!-- Accent Colors - Warm Orange & Coral -->
    <Color x:Key="AccentOrange">#FFA04D</Color>      <!-- Warm Orange -->
    <Color x:Key="AccentCoral">#FF7F7F</Color>       <!-- Soft Coral -->
    <Color x:Key="AccentPeach">#FFB39D</Color>       <!-- Peach Accent -->
    <Color x:Key="AccentPink">#FFB6C1</Color>        <!-- Soft Pink -->
    <Color x:Key="AccentCream">#FFF5E6</Color>       <!-- Cream Background -->
    
    <!-- Success & Error Colors -->
    <Color x:Key="SuccessColor">#FF9F87</Color>      <!-- Warm Coral Green -->
    <Color x:Key="ErrorColor">#FF7F7F</Color>        <!-- Soft Red/Pink -->
    <Color x:Key="WarningColor">#FFC470</Color>      <!-- Warm Yellow-Orange -->

    <!-- Light Theme Colors -->
    <Color x:Key="LightBackground">#FFFDFB</Color>   <!-- Warm White -->
    <Color x:Key="LightSurface">#FFF8F5</Color>      <!-- Very Light Peach -->
    <Color x:Key="LightCard">#FFFFFF</Color>         <!-- Pure White -->
    <Color x:Key="LightText">#4A3728</Color>         <!-- Warm Dark Brown -->
    <Color x:Key="LightTextSecondary">#8B7355</Color><!-- Warm Gray-Brown -->
    <Color x:Key="LightBorder">#FFE4D4</Color>       <!-- Soft Peach Border -->

    <!-- Dark Theme Colors -->
    <Color x:Key="DarkBackground">#2D1F1A</Color>   <!-- Warm Dark Brown -->
    <Color x:Key="DarkSurface">#3D2A22</Color>      <!-- Warm Brown -->
    <Color x:Key="DarkCard">#4A3528</Color>         <!-- Medium Brown -->
    <Color x:Key="DarkText">#FFE8DF</Color>          <!-- Soft Peach Text -->
    <Color x:Key="DarkTextSecondary">#C4A796</Color><!-- Warm Gray-Pink -->
    <Color x:Key="DarkBorder">#5C4033</Color>       <!-- Brown Border -->

    <!-- Neutral Colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#1A1A1A</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- Gray Scale -->
    <Color x:Key="Gray100">#FFF8F5</Color>
    <Color x:Key="Gray200">#FFE4D4</Color>
    <Color x:Key="Gray300">#FFD4BF</Color>
    <Color x:Key="Gray400">#C4A796</Color>
    <Color x:Key="Gray500">#8B7355</Color>
    <Color x:Key="Gray600">#6B5344</Color>
    <Color x:Key="Gray700">#4A3728</Color>
    <Color x:Key="Gray800">#3D2A22</Color>
    <Color x:Key="Gray900">#2D1F1A</Color>

    <!-- Brushes - Light Theme -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource LightBackground}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource LightSurface}"/>
    <SolidColorBrush x:Key="CardLightBrush" Color="{StaticResource LightCard}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource LightText}"/>
    <SolidColorBrush x:Key="TextSecondaryLightBrush" Color="{StaticResource LightTextSecondary}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource LightBorder}"/>

    <!-- Brushes - Dark Theme -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource DarkSurface}"/>
    <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource DarkCard}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource DarkText}"/>
    <SolidColorBrush x:Key="TextSecondaryDarkBrush" Color="{StaticResource DarkTextSecondary}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource DarkBorder}"/>

    <!-- Semantic Brushes with AppThemeBinding -->
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryColorLight}}"/>
    <SolidColorBrush x:Key="SecondaryColorBrush" Color="{AppThemeBinding Light={StaticResource SecondaryColor}, Dark={StaticResource SecondaryColorDark}}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}"/>
    <SolidColorBrush x:Key="TextColorBrush" Color="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
    <SolidColorBrush x:Key="TextSecondaryColorBrush" Color="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
    <SolidColorBrush x:Key="BorderColorBrush" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"/>

    <!-- Font Size Resources for Accessibility Scaling -->
    <x:Double x:Key="ExtraSmallFontSize">10</x:Double>
    <x:Double x:Key="SmallFontSize">12</x:Double>
    <x:Double x:Key="DefaultFontSize">14</x:Double>
    <x:Double x:Key="MediumFontSize">16</x:Double>
    <x:Double x:Key="LargeFontSize">18</x:Double>
    <x:Double x:Key="HeaderFontSize">20</x:Double>
    <x:Double x:Key="TitleFontSize">24</x:Double>
    <x:Double x:Key="LargeTitleFontSize">28</x:Double>
    <x:Double x:Key="ExtraLargeFontSize">32</x:Double>

    <!-- Spacing Resources (Thickness for Padding/Margin) -->
    <Thickness x:Key="SmallMargin">4</Thickness>
    <Thickness x:Key="MediumMargin">8</Thickness>
    <Thickness x:Key="DefaultMargin">12</Thickness>
    <Thickness x:Key="LargeMargin">16</Thickness>
    <Thickness x:Key="ExtraLargeMargin">24</Thickness>

    <!-- Spacing Resources (x:Double for Spacing property) -->
    <x:Double x:Key="SmallSpacing">4</x:Double>
    <x:Double x:Key="MediumSpacing">8</x:Double>
    <x:Double x:Key="DefaultSpacing">12</x:Double>
    <x:Double x:Key="LargeSpacing">16</x:Double>
    <x:Double x:Key="ExtraLargeSpacing">24</x:Double>

    <x:Double x:Key="SmallCornerRadius">4</x:Double>
    <x:Double x:Key="DefaultCornerRadius">8</x:Double>
    <x:Double x:Key="LargeCornerRadius">12</x:Double>
    <x:Double x:Key="ExtraLargeCornerRadius">16</x:Double>

    <!-- Button Heights for Accessibility (minimum 44pt) -->
    <x:Double x:Key="ButtonMinHeight">44</x:Double>
    <x:Double x:Key="ButtonMinWidth">44</x:Double>

</ResourceDictionary>
